# Large benchmark artifacts should be versioned through Git LFS so a clone/pull
# can reproduce the dataset tree without storing multi-GB blobs in Git history.
input/**/*.csv filter=lfs diff=lfs merge=lfs -text
input/**/*.txt filter=lfs diff=lfs merge=lfs -text
input/**/*.tsf filter=lfs diff=lfs merge=lfs -text
input/**/*.h5 filter=lfs diff=lfs merge=lfs -text
input/**/*.hdf5 filter=lfs diff=lfs merge=lfs -text
input/**/*.npz filter=lfs diff=lfs merge=lfs -text
input/**/*.npy filter=lfs diff=lfs merge=lfs -text
input/**/*.arrow filter=lfs diff=lfs merge=lfs -text
input/**/*.parquet filter=lfs diff=lfs merge=lfs -text
input/**/*.feather filter=lfs diff=lfs merge=lfs -text
input/**/*.zip filter=lfs diff=lfs merge=lfs -text
input/**/*.7z filter=lfs diff=lfs merge=lfs -text
input/**/*.gz filter=lfs diff=lfs merge=lfs -text
input/**/*.tar filter=lfs diff=lfs merge=lfs -text
input/**/*.tar.* filter=lfs diff=lfs merge=lfs -text

# GitHub LFS rejects single files larger than 2 GiB. These raw CSVs are stored
# as tracked chunks and reconstructed locally when needed.
input/Favorita/train.csv -filter -diff -merge text
input/G-Research-Crypto/train.csv -filter -diff -merge text
input/**/chunks/* filter=lfs diff=lfs merge=lfs -text

# Research-paper PDFs are part of the shared repo state, but should not inflate
# normal Git packfiles.
paper/**/*.pdf filter=lfs diff=lfs merge=lfs -text
